# Copy to .env for local runs. In Coolify set these in the app's Environment Variables.

# Admin account, created/promoted at startup. Change the password!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin

# Optional. If empty, a random key is generated and stored on the data volume.
SECRET_KEY=

# 1 when served over HTTPS (Coolify), 0 for plain http://localhost testing.
COOKIE_SECURE=1

TZ=Europe/Stockholm
